<div class="pd-root {{#unless editable}}is-readonly{{/unless}}">
  {{!-- Слот куколки: одна разметка для тела, рук и сумок --}}
  {{#*inline "pdSlot"}}
        <div class="pd-slot {{#unless top}}is-empty{{/unless}} {{#if maim}}{{#if maim.ok}}is-replaced{{else}}is-maimed{{/if}}{{/if}}" data-slot="{{key}}">
          <div class="pd-slot-frame" {{#if @root.editable}}title="{{label}}"{{/if}}>
            {{#if top}}
            <div class="pd-item rarity-{{top.rarity}} {{#if top.ghost}}is-ghost{{/if}}" data-item-id="{{top.id}}"
                 draggable="{{#if top.draggable}}true{{else}}false{{/if}}">
              <img src="{{top.img}}" alt="{{top.name}}">
              {{#if top.qty}}<span class="pd-qty">{{top.qty}}</span>{{/if}}
            </div>
            {{else}}
            <div class="pd-slot-placeholder" title="{{label}}"><img src="{{art}}" alt=""></div>
            {{/if}}
            {{#if layers}}<span class="pd-layers {{#if layersOnHover}}is-hover-only{{/if}}" title="{{localize "WFRPPD.Layers"}}: {{label}}">+{{layers}}</span>{{/if}}
            {{#if showAP}}<span class="pd-ap" title="AP: {{label}}">{{ap}}</span>{{/if}}
            {{#if maim}}<span class="pd-maim {{#if maim.ok}}is-ok{{/if}}" title="{{maim.title}}"><img src="{{maim.img}}" alt=""></span>{{/if}}
          </div>
        </div>
{{/inline}}

  <section class="pd-main">

    <header class="pd-hero">
      <div class="pd-hero-portrait" data-action="openSheet" title="{{name}}">
        <img src="{{img}}" alt="{{name}}">
      </div>
      <div class="pd-hero-text">
        <div class="pd-hero-name">{{name}}</div>
        {{#if subtitleParts.length}}<div class="pd-hero-sub">{{#each subtitleParts}}{{#unless @first}} · {{/unless}}<a class="pd-hero-part" data-kind="{{kind}}" title="{{localize "WFRPPD.Article.Open"}}">{{text}}</a>{{/each}}</div>{{/if}}
        {{#if money}}
        <div class="pd-money" title="{{money.hint}}&#10;{{money.rates}}&#10;{{localize "WFRPPD.Money.ClickHint"}}">
          {{#each money.parts}}<span class="pd-coin pd-coin--{{key}} {{#if img}}has-img{{/if}}" data-coin="{{key}}" title="{{title}}&#10;{{@root.money.hint}}&#10;{{@root.money.rates}}&#10;{{localize "WFRPPD.Money.ClickHint"}}">{{#if img}}<img src="{{img}}" alt="">{{/if}}{{value}}</span>{{/each}}
        </div>
        {{/if}}
      </div>
      {{#if careerIcon}}
      <div class="pd-hero-career" title="{{careerIcon.title}}">
        <img src="{{careerIcon.img}}" alt="">
      </div>
      {{else}}
      <div class="pd-hero-career is-empty"></div>
      {{/if}}
    </header>

    <div class="pd-doll">
      {{#each groups}}
      <div class="pd-group pd-group--{{area}}">
        {{!-- партиал в одну строку: иначе Handlebars добавляет отступ к переносам строк в подсказках --}}
        {{#each slots}}{{> pdSlot}}{{/each}}
      </div>
      {{/each}}

      <div class="pd-center">
        <div class="pd-model" data-action="openSheet">
          <img src="{{img}}" alt="{{name}}">
          {{#if effects.length}}
          <div class="pd-effects">
            {{#each effects}}
            <button type="button" class="pd-effect pd-effect--{{kind}} {{#if disabled}}is-disabled{{/if}}" data-index="{{@index}}" aria-label="{{name}}">
              <img src="{{img}}" alt="">
              {{#if value}}<span class="pd-effect-value">{{value}}</span>{{/if}}
            </button>
            {{/each}}
          </div>
          {{/if}}
          <div class="pd-enc is-{{encumbrance.state}}" title="{{encumbrance.hint}}">
            <div class="pd-enc-fill" style="width: {{encumbrance.pct}}%"></div>
            <span>{{localize "WFRPPD.Encumbrance"}} {{encumbrance.current}} / {{encumbrance.max}} · {{encumbrance.stateLabel}}</span>
          </div>
        </div>

        <div class="pd-statboxes">
          {{#each statPanels}}
          <div class="pd-statbox">
            <label class="pd-select">
              <select data-panel="{{@index}}">
                {{#each options}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
              <img src="{{@root.art.caret}}" alt="">
            </label>
            <div class="pd-statlist">
              {{#each rows}}
              <div class="pd-stat" {{#if hint}}title="{{hint}}"{{/if}}>
                <span class="pd-stat-label">{{label}}</span>
                <span class="pd-stat-value {{cls}}">{{value}}</span>
              </div>
              {{/each}}
            </div>
          </div>
          {{/each}}
        </div>
      </div>
    </div>
  </section>

  <section class="pd-side pd-bag">
    <nav class="pd-tabs">
      <button type="button" class="pd-tab {{#if tabBag}}is-active{{/if}}" data-action="setTab" data-tab="bag">
        <img src="{{art.tabBag}}" alt=""> {{localize "WFRPPD.Bag"}}
      </button>
      <button type="button" class="pd-tab {{#if tabStats}}is-active{{/if}}" data-action="setTab" data-tab="stats">
        <img src="{{art.tabStats}}" alt=""> {{localize "WFRPPD.StatsTab"}}
      </button>
    </nav>

    {{#if tabBag}}
    {{#if bagOverflow}}<div class="pd-bag-warn">{{bagOverflow}}</div>{{/if}}

    <div class="pd-filters">
      <div class="pd-filter-chips">
      {{#each filters}}
      <button type="button" class="pd-filter {{#if active}}is-active{{/if}}" data-action="setFilter" data-filter="{{key}}">
        {{label}} <span class="pd-filter-count">{{count}}</span>
      </button>
      {{/each}}
      </div>
      <div class="pd-sort">
        <button type="button" class="pd-sortbtn" data-action="toggleSortMenu" title="{{localize "WFRPPD.Sort.Title"}}" aria-label="{{localize "WFRPPD.Sort.Title"}}">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11M1.8 11.2 4 13.5l2.2-2.3M9 4h6M9 8h4.5M9 12h3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="pd-sortmenu {{#if sortOpen}}is-open{{/if}}">
          <div class="pd-sortmenu-title">{{localize "WFRPPD.Sort.Title"}}</div>
          {{#each sortOptions}}
          <button type="button" class="pd-sortopt {{#if active}}is-active{{/if}}" data-action="setSort" data-sort="{{key}}">{{label}}</button>
          {{/each}}
          <div class="pd-sortmenu-title">{{localize "WFRPPD.View.Title"}}</div>
          <button type="button" class="pd-sortopt {{#unless viewList}}is-active{{/unless}}" data-action="setView" data-view="grid">{{localize "WFRPPD.View.grid"}}</button>
          <button type="button" class="pd-sortopt {{#if viewList}}is-active{{/if}}" data-action="setView" data-view="list">{{localize "WFRPPD.View.list"}}</button>
        </div>
      </div>
    </div>

    <div class="pd-bag-list {{#if viewList}}is-list{{/if}}">
      {{#each bagSections}}
      <section class="pd-bagsec pd-bagsec--{{kind}} {{#if over}}is-over{{/if}} {{#if full}}is-full{{/if}}" {{#if noGrid}}data-free-slot="{{slot}}"{{else}}data-container="{{id}}"{{/if}}>
        <header class="pd-bagsec-head">
          {{#if img}}<img class="pd-bagsec-icon {{#if slot}}is-slot{{/if}}" src="{{img}}" alt="" {{#if slot}}data-slot="{{slot}}" title="{{localize "WFRPPD.Bags.SwapHint"}}"{{/if}}>{{else}}<img class="pd-bagsec-icon is-carried" src="{{@root.art.carried}}" alt="">{{/if}}
          <div class="pd-bagsec-title">
            <span class="pd-bagsec-name">{{name}}</span>
            {{#if slotLabel}}<span class="pd-bagsec-slot">{{slotLabel}}</span>{{/if}}
          </div>
          {{#if isLoose}}<span class="pd-bagsec-cap" title="{{localize "WFRPPD.Bags.LooseHint"}}">{{localize "WFRPPD.Bags.LooseShort"}} {{looseWeight}}</span>{{/if}}
          {{#if isLoose}}
          <button type="button" class="pd-pack {{#unless canPack}}is-idle{{/unless}}" {{#unless canPack}}disabled{{/unless}} data-action="autoPack" data-tooltip="{{localize "WFRPPD.Bags.Pack"}}: {{localize "WFRPPD.Bags.PackHint"}}" aria-label="{{localize "WFRPPD.Bags.Pack"}}" title="{{localize "WFRPPD.Bags.Pack"}}: {{localize "WFRPPD.Bags.PackHint"}}">
            <img src="{{@root.art.pack}}" alt="">
          </button>
          {{/if}}
        </header>
        {{#unless noGrid}}
        <div class="pd-bag-grid">
          {{#each items}}
          <div class="pd-item rarity-{{rarity}} {{#unless equippable}}is-plain{{/unless}} {{#if dimmed}}is-dimmed{{/if}}" data-item-id="{{id}}"
               draggable="{{#if draggable}}true{{else}}false{{/if}}">
            <img src="{{img}}" alt="{{name}}">
            {{#if qty}}<span class="pd-qty">{{qty}}</span>{{/if}}
            <span class="pd-item-name rarity-{{rarity}}">{{name}}</span>
          </div>
          {{/each}}
          {{#each cells}}<div class="pd-bag-cell"></div>{{/each}}
        </div>
        {{/unless}}
      </section>
      {{/each}}
    </div>

    {{else}}
    <div class="pd-ecs">
      {{#each statCategories}}
      <div class="pd-ecs-cat pd-ecs-cat--{{key}}">
        <div class="pd-ecs-head">{{#if art}}<img src="{{art}}" alt="">{{/if}}{{label}}</div>
        {{#each rows}}
        <div class="pd-ecs-row" {{#if hint}}title="{{hint}}"{{/if}}>
          <span class="pd-ecs-label">{{label}}</span>
          <span class="pd-ecs-value {{cls}}">{{value}}</span>
          <button type="button" class="pd-ecs-info" data-article="{{article}}" title="{{localize "WFRPPD.Article.Open"}}">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3.2C3.6 2.4 5.6 2.4 8 3.6c2.4-1.2 4.4-1.2 6 0V13c-1.6-.9-3.6-.9-6 .4-2.4-1.3-4.4-1.3-6-.4z M8 3.6V13.4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
          </button>
        </div>
        {{/each}}
      </div>
      {{/each}}
    </div>
    {{/if}}
  </section>

</div>
